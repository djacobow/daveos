option('platform', type: 'combo', choices: ['host', 'fake', 'stm32'], value: 'host')
option('board', type: 'combo', choices: ['h563', 'h755'], value: 'h563', description: 'Nucleo board for the STM32 console')
option('tests', type: 'boolean', value: true)
option('examples', type: 'boolean', value: true)
option('stm32_support', type: 'boolean', value: false, description: 'Provide Nucleo board and console dependencies without building the example')
option('logging', type: 'boolean', value: true, description: 'Enable buffered logging and log macros')
option('version_build', type: 'string', value: '4294967295', description: 'CI uint32 build number; UINT32_MAX denotes a local build')
option('bootloader', type: 'boolean', value: false, description: 'Build H563/H755 A/B firmware and factory image; standalone remains the default')
option('boot_version_major', type: 'integer', min: 0, value: 0)
option('boot_version_minor', type: 'integer', min: 0, value: 1)
option('openocd', type: 'string', value: '', description: 'OpenOCD executable; empty discovers the local install or PATH')
option('cubeprogrammer', type: 'string', value: '', description: 'STM32_Programmer_CLI executable; empty discovers the local install or PATH')
option('probe_serial', type: 'string', value: '', description: 'ST-LINK serial number for programming targets')

# One list selects libraries, board fixtures and console components. The table
# in meson.build states what each needs; see docs/reference.md#build-features.
# 'default' is uart,usb,health on STM32 and nothing on host/fake. Named sets
# live in meson/profiles/*.ini.
option('features', type: 'array', value: ['default'],
  choices: ['default', 'uart', 'usb', 'net', 'tcp', 'health', 'sd', 'sd-dma',
            'fatfs', 'file-transfer', 'i2c-adc', 'ssd1306', 'ota', 'otp-emulator', 'otp-h563'],
  description: 'Selected features (see meson/profiles/ for named sets)')

# Kept separate from features on purpose: permanent, board-altering writes.
option('otp_programming', type: 'boolean', value: false, description: 'Explicit real H563 OTP provisioning; never enable for automated HIL')
