option('platform', type: 'combo', choices: ['host', 'fake', 'stm32'], value: 'host')
option('board', type: 'combo', choices: ['h563', 'h755'], value: 'h563', description: 'Nucleo board for the STM32 console')
option('tests', type: 'boolean', value: true)
option('examples', type: 'boolean', value: true)
option('logging', type: 'boolean', value: true, description: 'Enable buffered logging and log macros')
option('openocd', type: 'string', value: '', description: 'OpenOCD executable; empty discovers the local install or PATH')
option('cubeprogrammer', type: 'string', value: '', description: 'STM32_Programmer_CLI executable; empty discovers the local install or PATH')
option('probe_serial', type: 'string', value: '', description: 'ST-LINK serial number for programming targets')
option('uart_console', type: 'boolean', value: true, description: 'Enable the STM32 USART3 command/log transport')
option('usb_console', type: 'boolean', value: true, description: 'Enable the STM32 USB CDC command/log transport')
option('networking', type: 'boolean', value: false, description: 'Enable optional lwIP IPv4 Ethernet support')
option('tcp_console', type: 'boolean', value: true, description: 'Enable the single-client TCP console on port 1000 when networking is enabled')
