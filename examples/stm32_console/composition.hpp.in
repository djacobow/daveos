#pragma once

// Generated selection only; reusable behavior belongs in the console library.
#include "application.h"
#include "platform/stm32/console/board.hpp"
#include "platform/stm32/console/console.hpp"
@INCLUDES@

namespace app {


  namespace stm32 = daveos::platform::stm32;
  using Board = stm32::Board<Event>;

  struct Components {
    Platform& platform;
@MEMBERS@

    auto console() { return stm32::Console{@CONSOLES@}; }

    auto modules(Board& board) { return console().modules(board@MODULES@); }

    auto subscribers() { return console().subscribers(); }

    auto sources() { return console().sources(); }

    void log_statistics(core::SchedulerInterface<Event>& scheduler) {
      console().log_statistics(scheduler);
    }

    void stop() {
      console().stop();
@STOP@
    }
  };


}  // namespace app
