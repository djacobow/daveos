board = "h755"
build = "build/net-h755"
bootloader = false
# For the A/B suite, use build/boot-h755 and bootloader = true; Meson must match.
probe_serial = "<H755-ST-LINK-serial>"
uart = "/dev/serial/by-id/<H755-ST-LINK-UART>"
usb = "/dev/serial/by-id/<DaveOS-H755-USB-CDC>"
gdb = "arm-none-eabi-gdb"
gdb_port = 3335
tcl_port = 6668
