# Core, host/fake adapters, and tests use the native build.
CompileFlags:
  CompilationDatabase: build/host

---
# Use real device headers for STM32 sources, not the host test register model.
If:
  PathMatch:
    - examples/stm32h563_blinky/.*
    - platform/stm32h5/.*
CompileFlags:
  CompilationDatabase: build/arm

---
If:
  PathMatch:
    - examples/stm32h755_console/.*
    - platform/stm32h7/.*
CompileFlags:
  CompilationDatabase: build/h755
